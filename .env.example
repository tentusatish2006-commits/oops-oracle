# =================================================================
# OOP'S ORACLE - ENVIRONMENT CONFIGURATION
# Tagline: Master Java. Master Logic. Build Your Future.
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL & Auth Credentials
# 1. Sign up at https://supabase.com
# 2. Create a project and run 'supabase-schema.sql' in the SQL Editor
# 3. Retrieve your Project URL and Anon/Service Keys from Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Razorpay Payment Gateway (Course purchases @ ₹5 INR)
# 1. Sign up at https://dashboard.razorpay.com
# 2. Generate API Keys in Settings -> API Keys (Use Test Mode for development)
# 3. Add Key ID and Secret below. OOP'S ORACLE has built-in simulation mode if left blank!
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpaySecretKey

# Judge0 Isolated Java Code Execution Service
# Optional: If provided, executes code on remote Judge0 instance.
# If not provided, OOP'S ORACLE automatically uses the built-in isolated sandbox
# and local Java 17 execution runner!
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_judge0_key_here
